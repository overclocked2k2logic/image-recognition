---
// Materials & Engineering Alloys Compatibility Matrix
---

<section class="section materials-section" id="materials">
  <div class="container">
    <div class="section-header">
      <div class="tech-badge">
        <span class="dot"></span>
        <span>METALLURGY & RAW MATERIAL SPECS</span>
      </div>
      <h2>Engineered Alloys <span class="gradient-text">& Material Matrix</span></h2>
      <p>
        We stock and machine certified raw materials with 100% mill test certificates (MTC 3.1) and complete chemical & mechanical batch traceability.
      </p>
    </div>

    <!-- Filter Buttons -->
    <div class="material-filters">
      <button type="button" class="mat-filter-btn active" data-filter="all">All Materials</button>
      <button type="button" class="mat-filter-btn" data-filter="stainless">Stainless Steels</button>
      <button type="button" class="mat-filter-btn" data-filter="carbon">Carbon & Alloy Steels</button>
      <button type="button" class="mat-filter-btn" data-filter="aluminum">Aluminum Alloys</button>
      <button type="button" class="mat-filter-btn" data-filter="copper">Brass & Copper</button>
      <button type="button" class="mat-filter-btn" data-filter="exotic">Superalloys & Polymers</button>
    </div>

    <!-- Materials Table / Cards Grid -->
    <div class="materials-grid">
      
      <!-- Material 1 -->
      <div class="material-card cyber-card" data-category="stainless">
        <div class="mat-card-header">
          <span class="mat-grade">SS 316L</span>
          <span class="mat-type">AUSTENITIC STAINLESS</span>
        </div>
        <h4>Marine & Pharma Grade Stainless</h4>
        <p>Molybdenum-bearing austenitic steel offering superior corrosion resistance against chlorides and acids.</p>
        <div class="mat-specs">
          <div><span>Machinability:</span> <strong>Good (Rigid Setup)</strong></div>
          <div><span>Max Laser Cut:</span> <strong>20 mm (N2 Assist)</strong></div>
          <div><span>Weldability:</span> <strong>Excellent (GTAW/GMAW)</strong></div>
          <div><span>Key Applications:</span> <strong>Chemical Reactors, Marine Fittings, Impellers</strong></div>
        </div>
      </div>

      <!-- Material 2 -->
      <div class="material-card cyber-card" data-category="stainless">
        <div class="mat-card-header">
          <span class="mat-grade">SS 304 / 304L</span>
          <span class="mat-type">FOOD & INDUSTRIAL STAINLESS</span>
        </div>
        <h4>Universal Corrosion-Resistant Alloy</h4>
        <p>The most widely utilized stainless alloy with excellent formability, oxidation resistance, and hygienic cleanability.</p>
        <div class="mat-specs">
          <div><span>Machinability:</span> <strong>Very Good</strong></div>
          <div><span>Max Laser Cut:</span> <strong>20 mm</strong></div>
          <div><span>Weldability:</span> <strong>Excellent</strong></div>
          <div><span>Key Applications:</span> <strong>Food Processing, Enclosures, SS Ducting</strong></div>
        </div>
      </div>

      <!-- Material 3 -->
      <div class="material-card cyber-card" data-category="aluminum">
        <div class="mat-card-header">
          <span class="mat-grade">AL 6061-T6</span>
          <span class="mat-type">HEAT-TREATED ALUMINUM</span>
        </div>
        <h4>High-Strength Structural Aluminum</h4>
        <p>Precipitation-hardened aluminum alloy containing magnesium and silicon. Superior strength-to-weight ratio.</p>
        <div class="mat-specs">
          <div><span>Machinability:</span> <strong>Excellent (High Speed)</strong></div>
          <div><span>Max Laser Cut:</span> <strong>16 mm</strong></div>
          <div><span>Anodizing:</span> <strong>Superb Type II/III</strong></div>
          <div><span>Key Applications:</span> <strong>Robotic Arms, Aerospace Brackets, Housings</strong></div>
        </div>
      </div>

      <!-- Material 4 -->
      <div class="material-card cyber-card" data-category="aluminum">
        <div class="mat-card-header">
          <span class="mat-grade">AL 7075-T6</span>
          <span class="mat-type">AEROSPACE GRADE</span>
        </div>
        <h4>Ultra High-Strength Aircraft Alloy</h4>
        <p>Zinc-alloyed aluminum delivering mechanical yield strengths comparable to many structural steels.</p>
        <div class="mat-specs">
          <div><span>Machinability:</span> <strong>Superb</strong></div>
          <div><span>Max Laser Cut:</span> <strong>12 mm</strong></div>
          <div><span>Tensile Strength:</span> <strong>572 MPa</strong></div>
          <div><span>Key Applications:</span> <strong>Gears, Precision Shafts, Aviation Parts</strong></div>
        </div>
      </div>

      <!-- Material 5 -->
      <div class="material-card cyber-card" data-category="carbon">
        <div class="mat-card-header">
          <span class="mat-grade">MS IS 2062 / EN8</span>
          <span class="mat-type">STRUCTURAL CARBON STEEL</span>
        </div>
        <h4>Heavy Structural & Machinery Steel</h4>
        <p>Medium carbon and structural steel with predictable yield and great response to flame/induction hardening.</p>
        <div class="mat-specs">
          <div><span>Machinability:</span> <strong>Outstanding</strong></div>
          <div><span>Max Laser Cut:</span> <strong>25 mm (Clean Edge)</strong></div>
          <div><span>Forming / Bending:</span> <strong>Excellent</strong></div>
          <div><span>Key Applications:</span> <strong>Heavy Base Plates, Machine Frames, Flanges</strong></div>
        </div>
      </div>

      <!-- Material 6 -->
      <div class="material-card cyber-card" data-category="copper">
        <div class="mat-card-header">
          <span class="mat-grade">Brass C360</span>
          <span class="mat-type">FREE-CUTTING BRASS</span>
        </div>
        <h4>High-Precision Turning Alloy</h4>
        <p>The industry benchmark for high-speed CNC turning with zero burr formation and mirror cosmetic finishes.</p>
        <div class="mat-specs">
          <div><span>Machinability:</span> <strong>100% (Benchmark)</strong></div>
          <div><span>Max Laser Cut:</span> <strong>10 mm</strong></div>
          <div><span>Corrosion:</span> <strong>High Spark / Water Proof</strong></div>
          <div><span>Key Applications:</span> <strong>Bushings, Valve Pins, Electrical Terminals</strong></div>
        </div>
      </div>

      <!-- Material 7 -->
      <div class="material-card cyber-card" data-category="exotic">
        <div class="mat-card-header">
          <span class="mat-grade">Inconel 625 / 718</span>
          <span class="mat-type">NICKEL SUPERALLOY</span>
        </div>
        <h4>High-Temperature & Petrochem Alloy</h4>
        <p>Nickel-chromium matrix designed for extreme thermal stability up to 980°C and severe corrosive chemical environments.</p>
        <div class="mat-specs">
          <div><span>Machinability:</span> <strong>Specialized Tooling</strong></div>
          <div><span>Heat Resistance:</span> <strong>Up to 980°C</strong></div>
          <div><span>Weldability:</span> <strong>Purged GTAW Certified</strong></div>
          <div><span>Key Applications:</span> <strong>Turbine Blisks, Flare Stacks, Downhole Tools</strong></div>
        </div>
      </div>

      <!-- Material 8 -->
      <div class="material-card cyber-card" data-category="exotic">
        <div class="mat-card-header">
          <span class="mat-grade">POM / Delrin & PEEK</span>
          <span class="mat-type">ENGINEERING POLYMERS</span>
        </div>
        <h4>Low-Friction Precision Plastics</h4>
        <p>Dimensionally stable high-performance polymers with zero moisture absorption and electrical insulation.</p>
        <div class="mat-specs">
          <div><span>Machinability:</span> <strong>Ultra Smooth</strong></div>
          <div><span>Dielectric:</span> <strong>High Voltage Rating</strong></div>
          <div><span>Wear Coefficient:</span> <strong>Extremely Low</strong></div>
          <div><span>Key Applications:</span> <strong>Gears, Bearings, Insulators, Manifolds</strong></div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .materials-section {
    background: var(--bg-primary);
  }

  .material-filters {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 3rem;
  }

  .mat-filter-btn {
    padding: 0.55rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    border-radius: var(--radius-full);
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mat-filter-btn:hover {
    color: var(--accent-cyan);
    border-color: var(--border-active);
    transform: translateY(-2px);
  }

  .mat-filter-btn.active {
    background: var(--accent-cyan);
    border-color: var(--accent-cyan);
    color: #ffffff;
    box-shadow: 0 4px 16px rgba(2, 132, 199, 0.35);
    transform: translateY(-2px);
  }

  .materials-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .material-card {
    display: flex;
    flex-direction: column;
    padding: 1.6rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .material-card:hover {
    border-color: var(--border-active);
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg), 0 10px 25px rgba(2, 132, 199, 0.12);
  }

  .mat-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .mat-grade {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--accent-cyan);
  }

  .mat-type {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .material-card h4 {
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .material-card p {
    font-size: 0.88rem;
    line-height: 1.5;
    margin-bottom: 1.25rem;
    flex-grow: 1;
    color: var(--text-secondary);
  }

  .mat-specs {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-size: 0.8rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0.85rem;
  }

  .mat-specs span {
    color: var(--text-muted);
    font-weight: 500;
  }

  .mat-specs strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  @media (max-width: 1200px) {
    .materials-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .materials-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.mat-filter-btn');
    const cards = document.querySelectorAll('.material-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');

        cards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-category') === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });
</script>
