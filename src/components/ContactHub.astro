---
// Comprehensive Multi-Facility Contact Hub & Map Component
---

<section class="section contact-section" id="contact">
  <div class="container">
    <div class="section-header">
      <div class="tech-badge amber">
        <span class="dot"></span>
        <span>GET IN TOUCH WITH JECON</span>
      </div>
      <h2>Corporate Headquarters <span class="gradient-text-orange">& Plant Locations</span></h2>
      <p>
        Visit our state-of-the-art manufacturing works in GIDC Savli Manjusar or connect with our corporate engineering team in Vadodara.
      </p>
    </div>

    <div class="contact-grid">
      
      <!-- Facility Cards Column -->
      <div class="facility-cards-col reveal-left">
        
        <!-- Card 1: Manufacturing Works -->
        <div class="facility-card cyber-card active-card">
          <div class="fac-tag">MANUFACTURING WORKS & MACHINING PLANT</div>
          <h3>Savli Manjusar Plant</h3>
          <p class="fac-address">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent-orange)" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Plot No. 552 & 557, GIDC Savli, Manjusar, Vadodara – 391775, Gujarat, India</span>
          </p>

          <div class="fac-contacts">
            <div class="contact-row">
              <span class="contact-lbl">Plant / RFQ Direct:</span>
              <a href="tel:+918511142772" class="contact-val">+91 85111 42772 (Mr. Devendra Singh, GM)</a>
            </div>
            <div class="contact-row">
              <span class="contact-lbl">Engineering Operations:</span>
              <a href="tel:+918320897847" class="contact-val">+91 83208 97847</a>
            </div>
            <div class="contact-row">
              <span class="contact-lbl">Works Email:</span>
              <a href="mailto:info@jeconengineers.com" class="contact-val">info@jeconengineers.com</a>
            </div>
          </div>
        </div>

        <!-- Card 2: Corporate Office -->
        <div class="facility-card cyber-card">
          <div class="fac-tag">CORPORATE HEADQUARTERS</div>
          <h3>Vadodara Corporate Office</h3>
          <p class="fac-address">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent-cyan)" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>802, Neptune Edge, Near Genda Circle, Dr. Vikram Sarabhai Compound, Racecourse, Vadodara – 390007, Gujarat, India</span>
          </p>

          <div class="fac-contacts">
            <div class="contact-row">
              <span class="contact-lbl">Corporate HR Dept:</span>
              <a href="tel:+918320897847" class="contact-val">+91 83208 97847 / hr@jeconengineers.com</a>
            </div>
            <div class="contact-row">
              <span class="contact-lbl">Accounts / Admin:</span>
              <a href="tel:+918511182061" class="contact-val">+91 85111 82061 / salary1@jeconengineers.com</a>
            </div>
            <div class="contact-row">
              <span class="contact-lbl">Executive Mail:</span>
              <a href="mailto:nileshparikh5@hotmail.com" class="contact-val">nileshparikh5@hotmail.com</a>
            </div>
          </div>
        </div>

        <!-- Direct WhatsApp Action Card -->
        <div class="whatsapp-direct-card">
          <div class="wa-icon-box">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#25d366" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          </div>
          <div class="wa-content">
            <h4>Quick WhatsApp Technical Desk</h4>
            <p>Send 2D/3D drawings directly on WhatsApp for instant review by our chief estimator.</p>
          </div>
          <a href="https://wa.me/918511142772?text=Hello%20Jecon%20Engineering%20Services,%20I%20would%20like%20to%20inquire%20about%20precision%20manufacturing%20services" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
            <span>Chat +91 85111 42772</span>
          </a>
        </div>

      </div>

      <!-- Interactive Map & Quick Message Form Column -->
      <div class="map-form-col reveal-right">
        <div class="map-wrapper cyber-card">
          <div class="map-header">
            <div class="map-title">
              <span class="pulse-dot-cyan"></span>
              <span>GEO LOCATION // VADODARA INDUSTRIAL BELT</span>
            </div>
            <a href="https://maps.google.com/?q=GIDC+Savli+Manjusar+Vadodara" target="_blank" rel="noopener noreferrer" class="map-external-link">
              <span>Open in Google Maps</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </div>

          <div class="map-embed-container">
            <iframe 
              title="Jecon Facilities Vadodara & Savli GIDC Map"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d118147.68334460773!2d73.10926834015694!3d22.31174987979603!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x395fc5e50529d2b9%3A0xb35a5198ec48c081!2sSavli%20GIDC%2C%20Manjusar%2C%20Gujarat%20391775!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin"
              width="100%" 
              height="340" 
              style="border:0;" 
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade">
            </iframe>
          </div>

          <div class="quick-inquiry-box">
            <h4>Direct Technical Inquiry</h4>
            <form onsubmit="event.preventDefault(); alert('Inquiry Sent! Our GM Mr. Devendra Singh or technical team will contact you shortly at +91 85111 42772.');">
              <div class="form-row-2">
                <input type="text" class="form-input" placeholder="Your Name" required />
                <input type="tel" class="form-input" placeholder="Phone Number" required />
              </div>
              <div class="form-group" style="margin-top: 0.75rem; margin-bottom: 0.75rem;">
                <textarea class="form-textarea" rows="2" placeholder="Brief requirement (e.g. 500 pcs laser cut bracket SS304)..." required></textarea>
              </div>
              <button type="submit" class="btn btn-orange w-full">Send Message to Plant Head</button>
            </form>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .contact-section {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-subtle);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 2.5rem;
  }

  .facility-cards-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .facility-card {
    padding: 2rem;
  }

  .facility-card.active-card {
    border-color: rgba(255, 107, 0, 0.4);
    box-shadow: 0 8px 30px rgba(255, 107, 0, 0.15);
  }

  .fac-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--accent-orange);
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .facility-card:nth-child(2) .fac-tag {
    color: var(--accent-cyan);
  }

  .facility-card h3 {
    font-size: 1.35rem;
    margin-bottom: 0.75rem;
  }

  .fac-address {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .fac-address svg {
    flex-shrink: 0;
    margin-top: 3px;
  }

  .fac-contacts {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    font-size: 0.82rem;
    gap: 0.25rem;
  }

  .contact-lbl {
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .contact-val {
    color: var(--text-primary);
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .contact-val:hover {
    color: var(--accent-cyan);
  }

  /* WhatsApp Direct Card */
  .whatsapp-direct-card {
    background: rgba(37, 211, 102, 0.08);
    border: 1px solid rgba(37, 211, 102, 0.3);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .wa-icon-box {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(37, 211, 102, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .wa-content {
    flex-grow: 1;
  }

  .wa-content h4 {
    font-size: 1rem;
    color: #25d366;
    margin-bottom: 0.2rem;
  }

  .wa-content p {
    font-size: 0.78rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.3;
  }

  /* Right Side Map & Quick Form */
  .map-wrapper {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .map-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .map-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-cyan);
    letter-spacing: 0.05em;
  }

  .pulse-dot-cyan {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-cyan);
    box-shadow: 0 0 8px var(--accent-cyan);
  }

  .map-external-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .map-external-link:hover {
    color: var(--accent-cyan);
  }

  .map-embed-container {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    filter: invert(90%) hue-rotate(180deg) brightness(85%) contrast(1.1);
  }

  [data-theme="light"] .map-embed-container {
    filter: none;
  }

  .quick-inquiry-box h4 {
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
  }

  .w-full {
    width: 100%;
  }

  @media (max-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .whatsapp-direct-card {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
