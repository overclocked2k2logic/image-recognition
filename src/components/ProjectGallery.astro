---
// Project & Component Showcase Gallery Component
---

<section class="section gallery-section" id="gallery">
  <div class="container">
    <div class="section-header">
      <div class="tech-badge">
        <span class="dot"></span>
        <span>PRODUCTION SHOWCASE</span>
      </div>
      <h2>Engineered Components <span class="gradient-text">& Project Gallery</span></h2>
      <p>
        Explore real manufactured components and assemblies produced at our Savli Vadodara plant for energy, refinery, petrochemical, and precision industrial clients.
      </p>
    </div>

    <!-- Gallery Categories -->
    <div class="gallery-filter-bar">
      <button type="button" class="gal-btn active" data-filter="all">All Components</button>
      <button type="button" class="gal-btn" data-filter="cnc">CNC Machining</button>
      <button type="button" class="gal-btn" data-filter="laser">Laser Cut Parts</button>
      <button type="button" class="gal-btn" data-filter="fabrication">Fabrication & Bending</button>
      <button type="button" class="gal-btn" data-filter="cad">CAD & Engineering</button>
    </div>

    <!-- Gallery Grid -->
    <div class="gallery-grid">
      
      <!-- Item 1: CNC Parts -->
      <div class="gallery-card" data-cat="cnc">
        <div class="gallery-img-wrap">
          <img src="/assets/images/cnc-parts.jpeg" alt="Precision CNC Machined Metal Parts" loading="lazy" />
          <div class="gallery-zoom-overlay">
            <span class="zoom-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
            </span>
          </div>
        </div>
        <div class="gallery-meta">
          <div class="meta-tag">SS 316L / AL 6061</div>
          <h4>Precision CNC Machined Components</h4>
          <p>Multi-axis VMC turned & milled couplings with Ra 0.4µm finish and ±0.005mm bore tolerances.</p>
        </div>
      </div>

      <!-- Item 2: CNC Milling -->
      <div class="gallery-card" data-cat="cnc">
        <div class="gallery-img-wrap">
          <img src="/assets/images/cnc-milling.jpeg" alt="CNC Milling Machine Cutting Metal" loading="lazy" />
          <div class="gallery-zoom-overlay">
            <span class="zoom-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
            </span>
          </div>
        </div>
        <div class="gallery-meta">
          <div class="meta-tag">5-AXIS VMC</div>
          <h4>High-Speed Complex Pocket Milling</h4>
          <p>Direct CAM toolpathing for intricate aerodynamic geometry and high-hardness die steel.</p>
        </div>
      </div>

      <!-- Item 3: Laser Cutting -->
      <div class="gallery-card" data-cat="laser">
        <div class="gallery-img-wrap">
          <img src="/assets/images/laser-cutting.jpeg" alt="Fiber Laser Cutter Cutting Steel Sheet" loading="lazy" />
          <div class="gallery-zoom-overlay">
            <span class="zoom-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
            </span>
          </div>
        </div>
        <div class="gallery-meta">
          <div class="meta-tag orange">6kW FIBER LASER</div>
          <h4>High-Power Sheet Profile Cutting</h4>
          <p>Clean, dross-free laser profiling on 20mm stainless steel with high-pressure nitrogen gas assist.</p>
        </div>
      </div>

      <!-- Item 4: CAD Workstation -->
      <div class="gallery-card" data-cat="cad">
        <div class="gallery-img-wrap">
          <img src="/assets/images/cad-workstation.jpeg" alt="CAD Workstation Displaying Turbine Assembly" loading="lazy" />
          <div class="gallery-zoom-overlay">
            <span class="zoom-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
            </span>
          </div>
        </div>
        <div class="gallery-meta">
          <div class="meta-tag blue">CAD / CAM / FEA</div>
          <h4>Turbine Impeller & Rotor Modeling</h4>
          <p>Parametric 3D CAD design, CFD flow verification, and DFM optimization for manufacturing.</p>
        </div>
      </div>

      <!-- Item 5: Sheet Bending -->
      <div class="gallery-card" data-cat="fabrication">
        <div class="gallery-img-wrap">
          <img src="/assets/images/sheet-bending.jpeg" alt="CNC Press Brake Sheet Metal Bending" loading="lazy" />
          <div class="gallery-zoom-overlay">
            <span class="zoom-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
            </span>
          </div>
        </div>
        <div class="gallery-meta">
          <div class="meta-tag amber">150-TON PRESS BRAKE</div>
          <h4>Precision Sheet Metal Enclosures</h4>
          <p>Multi-bend electronic chassis, server racks, and control console housings with zero springback error.</p>
        </div>
      </div>

      <!-- Item 6: Welded Frame -->
      <div class="gallery-card" data-cat="fabrication">
        <div class="gallery-img-wrap">
          <img src="/assets/images/welding-fabrication.jpeg" alt="Welder Fabricating Steel Structural Frame" loading="lazy" />
          <div class="gallery-zoom-overlay">
            <span class="zoom-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
            </span>
          </div>
        </div>
        <div class="gallery-meta">
          <div class="meta-tag amber">ASME CERTIFIED TIG/MIG</div>
          <h4>Structural Steel & Skid Fabrication</h4>
          <p>Heavy machinery base frames, pressure piping headers, and industrial ducting systems.</p>
        </div>
      </div>

      <!-- Item 7: Robotic Machining -->
      <div class="gallery-card" data-cat="cnc">
        <div class="gallery-img-wrap">
          <img src="/assets/images/robotic-machining.jpeg" alt="Robotic Arm Carving Brass Component" loading="lazy" />
          <div class="gallery-zoom-overlay">
            <span class="zoom-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
            </span>
          </div>
        </div>
        <div class="gallery-meta">
          <div class="meta-tag cyan">ROBOTIC PRECISION</div>
          <h4>High-Speed Brass Sculpting</h4>
          <p>Automated multi-axis robotic sculpting of custom brass hardware and valve mechanisms.</p>
        </div>
      </div>

      <!-- Item 8: Blueprint Drawing -->
      <div class="gallery-card" data-cat="cad">
        <div class="gallery-img-wrap">
          <img src="/assets/images/blueprint-drawing.jpeg" alt="Engineering Blueprint Technical Drawing" loading="lazy" />
          <div class="gallery-zoom-overlay">
            <span class="zoom-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
            </span>
          </div>
        </div>
        <div class="gallery-meta">
          <div class="meta-tag blue">BLUEPRINT TO PART</div>
          <h4>Complete Technical Documentation</h4>
          <p>GD&T drafting, assembly exploded views, bill of materials (BOM), and manufacturing routing sheets.</p>
        </div>
      </div>

    </div>
  </div>

  <!-- Lightbox Modal -->
  <div id="gallery-lightbox" class="lightbox-modal">
    <div class="lightbox-backdrop"></div>
    <div class="lightbox-box">
      <button type="button" class="lightbox-close" id="lightbox-close">&times;</button>
      <img id="lightbox-img" src="" alt="Zoomed view" />
      <div class="lightbox-caption">
        <h4 id="lightbox-title"></h4>
        <p id="lightbox-desc"></p>
      </div>
    </div>
  </div>
</section>

<style>
  .gallery-section {
    background: var(--bg-primary);
  }

  .gallery-filter-bar {
    display: flex;
    justify-content: center;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .gal-btn {
    padding: 0.55rem 1.35rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    border-radius: var(--radius-full);
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gal-btn:hover {
    color: var(--accent-cyan);
    border-color: var(--border-active);
    transform: translateY(-2px);
  }

  .gal-btn.active {
    background: var(--accent-cyan);
    border-color: var(--accent-cyan);
    color: #ffffff;
    box-shadow: 0 4px 16px rgba(2, 132, 199, 0.35);
    transform: translateY(-2px);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .gallery-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-md);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }

  .gallery-card:hover {
    border-color: var(--border-active);
    transform: translateY(-7px);
    box-shadow: var(--shadow-lg), 0 10px 25px rgba(2, 132, 199, 0.15);
  }

  .gallery-img-wrap {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
  }

  .gallery-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery-card:hover .gallery-img-wrap img {
    transform: scale(1.08);
  }

  .gallery-zoom-overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    backdrop-filter: blur(2px);
    transition: opacity 0.3s ease;
  }

  .gallery-card:hover .gallery-zoom-overlay {
    opacity: 1;
  }

  .zoom-icon {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--accent-cyan);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 15px rgba(2, 132, 199, 0.4);
    transform: scale(0.7);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery-card:hover .zoom-icon {
    transform: scale(1);
  }

  .gallery-meta {
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex-grow: 1;
  }

  .meta-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--accent-cyan);
    letter-spacing: 0.06em;
  }

  .meta-tag.orange { color: var(--accent-orange); }
  .meta-tag.blue { color: var(--accent-blue); }
  .meta-tag.amber { color: var(--accent-amber); }

  .gallery-meta h4 {
    font-size: 1.05rem;
    line-height: 1.35;
    color: var(--text-primary);
  }

  .gallery-meta p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Lightbox Modal */
  .lightbox-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    padding: 1.5rem;
  }

  .lightbox-modal.open {
    opacity: 1;
    visibility: visible;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(4, 7, 13, 0.9);
    backdrop-filter: blur(16px);
  }

  .lightbox-box {
    position: relative;
    z-index: 2;
    max-width: 800px;
    width: 100%;
    background: var(--bg-secondary);
    border: 1px solid var(--border-active);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8);
    animation: zoomIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes zoomIn {
    from { transform: scale(0.92); }
    to { transform: scale(1); }
  }

  .lightbox-box img {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
  }

  .lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 36px;
    height: 36px;
    background: rgba(0, 0, 0, 0.7);
    border: 1px solid var(--border-subtle);
    color: #ffffff;
    font-size: 1.5rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .lightbox-close:hover {
    background: var(--accent-cyan);
    color: #050b14;
  }

  .lightbox-caption {
    padding: 1.5rem;
    background: var(--bg-card);
  }

  .lightbox-caption h4 {
    font-size: 1.2rem;
    margin-bottom: 0.35rem;
    color: var(--text-primary);
  }

  .lightbox-caption p {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  @media (max-width: 1200px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const galBtns = document.querySelectorAll('.gal-btn');
    const cards = document.querySelectorAll('.gallery-card');
    const lightbox = document.getElementById('gallery-lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxDesc = document.getElementById('lightbox-desc');
    const lightboxClose = document.getElementById('lightbox-close');
    const backdrop = document.querySelector('.lightbox-backdrop');

    // Filter
    galBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        galBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');

        cards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-cat') === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Lightbox modal opener
    cards.forEach(card => {
      card.addEventListener('click', () => {
        const img = card.querySelector('img');
        const title = card.querySelector('h4')?.textContent || '';
        const desc = card.querySelector('p')?.textContent || '';

        if (lightbox && lightboxImg && img) {
          lightboxImg.src = img.src;
          if (lightboxTitle) lightboxTitle.textContent = title;
          if (lightboxDesc) lightboxDesc.textContent = desc;
          lightbox.classList.add('open');
        }
      });
    });

    function closeLightbox() {
      if (lightbox) lightbox.classList.remove('open');
    }

    lightboxClose?.addEventListener('click', closeLightbox);
    backdrop?.addEventListener('click', closeLightbox);
  });
</script>
