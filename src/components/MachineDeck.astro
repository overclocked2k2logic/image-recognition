---
// Machine Deck & Technical Facility Equipment Fleet
---

<section class="section machine-deck-section" id="capabilities">
  <div class="container">
    <div class="section-header">
      <div class="tech-badge">
        <span class="dot"></span>
        <span>MANUFACTURING INFRASTRUCTURE</span>
      </div>
      <h2>Advanced Machinery <span class="gradient-text">& Equipment Fleet</span></h2>
      <p>
        Housed in our dedicated facility at GIDC Savli, Manjusar (Vadodara), our modern CNC machine fleet and fabrication equipment enable tight-tolerance batch production and rapid turnarounds.
      </p>
    </div>

    <div class="machines-grid">
      
      <!-- Card 1: 5-Axis VMC -->
      <div class="machine-card cyber-card">
        <div class="machine-badge cyan">HIGH-SPEED MILLING</div>
        <div class="machine-visual">
          <img src="/assets/images/cnc-milling.jpeg" alt="5-Axis CNC Vertical Machining Center" loading="lazy" />
        </div>
        <div class="machine-info">
          <h3>5-Axis / 4-Axis CNC Machining Centers</h3>
          <p class="machine-desc">High-rigidity VMC equipped with linear scales and high-pressure through-spindle coolant for exotic alloys.</p>
          
          <ul class="machine-specs">
            <li>
              <span class="lbl">Travel (X/Y/Z)</span>
              <span class="val">1,200 x 700 x 600 mm</span>
            </li>
            <li>
              <span class="lbl">Max Spindle Speed</span>
              <span class="val">15,000 RPM (Direct Drive)</span>
            </li>
            <li>
              <span class="lbl">Tool Capacity</span>
              <span class="val">30 Tools (ATC Twin Arm)</span>
            </li>
            <li>
              <span class="lbl">Positional Accuracy</span>
              <span class="val highlight">± 0.005 mm</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Card 2: 6kW Fiber Laser -->
      <div class="machine-card cyber-card">
        <div class="machine-badge orange">6000W OPTICAL FIBER</div>
        <div class="machine-visual">
          <img src="/assets/images/laser-cutting.jpeg" alt="6kW Industrial Fiber Laser Cutting System" loading="lazy" />
        </div>
        <div class="machine-info">
          <h3>6kW High-Power Fiber Laser Cutting System</h3>
          <p class="machine-desc">Equipped with Precitec auto-focus cutting head, nitrogen assist high-pressure piercing, and dual exchange pallets.</p>
          
          <ul class="machine-specs">
            <li>
              <span class="lbl">Cutting Bed Area</span>
              <span class="val">3,000 x 1,500 mm Dual Pallet</span>
            </li>
            <li>
              <span class="lbl">Laser Source</span>
              <span class="val">6,000 W Solid-State Fiber</span>
            </li>
            <li>
              <span class="lbl">Max Thickness</span>
              <span class="val">MS 25mm | SS 20mm | AL 16mm</span>
            </li>
            <li>
              <span class="lbl">Repetitive Precision</span>
              <span class="val highlight">± 0.02 mm</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Card 3: CNC Press Brake -->
      <div class="machine-card cyber-card">
        <div class="machine-badge amber">150-TON HYDRAULIC</div>
        <div class="machine-visual">
          <img src="/assets/images/sheet-bending.jpeg" alt="150 Ton Multi-Axis CNC Press Brake" loading="lazy" />
        </div>
        <div class="machine-info">
          <h3>150-Ton Multi-Axis CNC Press Brake</h3>
          <p class="machine-desc">Electro-hydraulic synchro press brake with Delem CNC graphics controller and automated hydraulic crowning.</p>
          
          <ul class="machine-specs">
            <li>
              <span class="lbl">Bending Capacity</span>
              <span class="val">150 Metric Tons</span>
            </li>
            <li>
              <span class="lbl">Max Bending Length</span>
              <span class="val">3,200 mm (10.5 Feet)</span>
            </li>
            <li>
              <span class="lbl">Backgauge Control</span>
              <span class="val">4+1 Axis Multi-Axis CNC</span>
            </li>
            <li>
              <span class="lbl">Angle Accuracy</span>
              <span class="val highlight">± 0.25°</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Card 4: Precision Turning -->
      <div class="machine-card cyber-card">
        <div class="machine-badge cyan">LIVE TOOLING LATHE</div>
        <div class="machine-visual">
          <img src="/assets/images/robotic-machining.jpeg" alt="Precision CNC Turning and Mill-Turn Center" loading="lazy" />
        </div>
        <div class="machine-info">
          <h3>Heavy Duty CNC Turning Centers</h3>
          <p class="machine-desc">Slant bed CNC lathes designed for heavy cutting of shafts, flanges, couplings, and precision bushing components.</p>
          
          <ul class="machine-specs">
            <li>
              <span class="lbl">Max Turning Diameter</span>
              <span class="val">Ø 450 mm</span>
            </li>
            <li>
              <span class="lbl">Max Turning Length</span>
              <span class="val">1,000 mm Between Centers</span>
            </li>
            <li>
              <span class="lbl">Spindle Bore</span>
              <span class="val">Ø 80 mm Through-Hole</span>
            </li>
            <li>
              <span class="lbl">Runout Accuracy</span>
              <span class="val highlight">± 0.003 mm</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Card 5: Welding & Robotic Cells -->
      <div class="machine-card cyber-card">
        <div class="machine-badge blue">CERTIFIED FABRICATION</div>
        <div class="machine-visual">
          <img src="/assets/images/welding-fabrication.jpeg" alt="TIG MIG and Robotic Welding Stations" loading="lazy" />
        </div>
        <div class="machine-info">
          <h3>Robotic & Certified TIG / MIG Welding Cells</h3>
          <p class="machine-desc">Specialized welding bays equipped with argon purgers, motorized rotators, and ASME Sec IX certified welders.</p>
          
          <ul class="machine-specs">
            <li>
              <span class="lbl">Processes</span>
              <span class="val">TIG (GTAW), MIG (GMAW), Spot</span>
            </li>
            <li>
              <span class="lbl">Materials</span>
              <span class="val">SS 316, Hastelloy, Carbon Steel</span>
            </li>
            <li>
              <span class="lbl">Testing Standards</span>
              <span class="val">Dye Penetrant, Hydrostatic, UT</span>
            </li>
            <li>
              <span class="lbl">Welder Certs</span>
              <span class="val highlight">ASME Sec IX & EN ISO</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Card 6: Metrology & CMM -->
      <div class="machine-card cyber-card">
        <div class="machine-badge cyan">QA & METROLOGY</div>
        <div class="machine-visual">
          <img src="/assets/images/cad-workstation.jpeg" alt="Coordinate Measuring Machine Metrology Quality Control" loading="lazy" />
        </div>
        <div class="machine-info">
          <h3>Climate-Controlled CMM & Metrology Lab</h3>
          <p class="machine-desc">Full traceability and 100% dimensional inspection with 3D Coordinate Measuring Machines and optical profile projectors.</p>
          
          <ul class="machine-specs">
            <li>
              <span class="lbl">CMM Accuracy</span>
              <span class="val highlight">0.001 mm (1 Micron)</span>
            </li>
            <li>
              <span class="lbl">Optical Projector</span>
              <span class="val">300mm Screen 50x Magnification</span>
            </li>
            <li>
              <span class="lbl">Surface Tester</span>
              <span class="val">Mitutoyo Surftest SJ-210</span>
            </li>
            <li>
              <span class="lbl">Documentation</span>
              <span class="val">Full FAI & CMM Inspection Sheets</span>
            </li>
          </ul>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .machine-deck-section {
    background: #121417;
    border-bottom: 1px solid #2D333F;
  }

  .machines-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .machine-card {
    display: flex;
    flex-direction: column;
    padding: 1.6rem;
    position: relative;
    background: #161A22;
    border: 1px solid #2D333F;
    border-radius: var(--radius-lg);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.55);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .machine-card:hover {
    border-color: rgba(14, 165, 233, 0.45);
    transform: translateY(-8px);
    box-shadow: 0 22px 44px rgba(0, 0, 0, 0.65), 0 0 24px rgba(14, 165, 233, 0.10);
  }

  .machine-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.28rem 0.65rem;
    border-radius: var(--radius-sm);
    z-index: 2;
    letter-spacing: 0.06em;
    backdrop-filter: blur(8px);
  }

  .machine-badge.cyan { background: var(--accent-cyan-subtle); color: var(--accent-cyan); border: 1px solid var(--border-active); }
  .machine-badge.orange { background: rgba(234, 88, 12, 0.1); color: var(--accent-orange); border: 1px solid rgba(234, 88, 12, 0.35); }
  .machine-badge.amber { background: rgba(245, 158, 11, 0.1); color: var(--accent-amber); border: 1px solid rgba(245, 158, 11, 0.35); }
  .machine-badge.blue { background: rgba(37, 99, 235, 0.1); color: var(--accent-blue); border: 1px solid rgba(37, 99, 235, 0.35); }

  .machine-visual {
    width: 100%;
    height: 200px;
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: 1.35rem;
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-sm);
  }

  .machine-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .machine-card:hover .machine-visual img {
    transform: scale(1.06);
  }

  .machine-info h3 {
    font-size: 1.22rem;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .machine-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 1.35rem;
    min-height: 44px;
  }

  .machine-specs {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    background: rgba(10, 13, 18, 0.6);
    border: 1px solid #2D333F;
    border-radius: var(--radius-md);
    padding: 0.95rem;
    font-family: var(--font-mono);
  }

  .machine-specs li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
  }

  .machine-specs .lbl {
    color: var(--text-muted);
    font-weight: 500;
  }

  .machine-specs .val {
    color: var(--text-primary);
    font-weight: 600;
  }

  .machine-specs .val.highlight {
    color: var(--accent-cyan);
  }

  @media (max-width: 1100px) {
    .machines-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .machines-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
