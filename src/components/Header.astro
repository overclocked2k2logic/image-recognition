---
interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <!-- Brand Logo -->
    <a href="/" class="brand-logo" aria-label="Jecon Engineering Services Homepage">
      <div class="logo-symbol">
        <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="40" height="40" rx="8" fill="rgba(0, 240, 255, 0.1)" stroke="var(--accent-cyan)" stroke-width="1.5"/>
          <circle cx="20" cy="20" r="12" stroke="var(--accent-cyan)" stroke-width="1.5" stroke-dasharray="3 3"/>
          <circle cx="20" cy="20" r="6" stroke="var(--accent-orange)" stroke-width="2"/>
          <circle cx="20" cy="20" r="2" fill="var(--accent-cyan)"/>
          <path d="M20 2V8M20 32V38M2 20H8M32 20H38" stroke="var(--accent-cyan)" stroke-width="1.5"/>
        </svg>
      </div>
      <div class="logo-text">
        <span class="company-name">JECON</span>
        <span class="company-sub">ENGINEERING SERVICES</span>
        <span class="company-tag">A SISTER CO. OF JECON ENGINEERS</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        <li>
          <a href="/" class={`nav-link ${currentPath === "/" ? "active" : ""}`}>Home</a>
        </li>
        <li class="nav-dropdown-wrapper">
          <a href="/#services" class={`nav-link dropdown-toggle ${currentPath.startsWith("/services") ? "active" : ""}`}>
            <span>Services</span>
            <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </a>
          <div class="dropdown-menu">
            <div class="dropdown-arrow"></div>
            <a href="/services/cnc-machining" class="dropdown-item">
              <div class="drop-icon cyan">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
              </div>
              <div class="drop-content">
                <strong>CNC Machining & Turning</strong>
                <span>3/4/5-Axis VMC & high-precision turning</span>
              </div>
            </a>
            <a href="/services/laser-cutting" class="dropdown-item">
              <div class="drop-icon orange">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"/><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"/><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"/></svg>
              </div>
              <div class="drop-content">
                <strong>Fiber Laser Cutting</strong>
                <span>6kW optical power, MS, SS & Aluminum</span>
              </div>
            </a>
            <a href="/services/cad-engineering" class="dropdown-item">
              <div class="drop-icon blue">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
              </div>
              <div class="drop-content">
                <strong>CAD / CAM & Engineering</strong>
                <span>3D SolidWorks, DFM & reverse engineering</span>
              </div>
            </a>
            <a href="/services/sheet-metal-fabrication" class="dropdown-item">
              <div class="drop-icon amber">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
              </div>
              <div class="drop-content">
                <strong>Sheet Metal & Heavy Fabrication</strong>
                <span>CNC press brake bending & robotic welding</span>
              </div>
            </a>
          </div>
        </li>
        <li>
          <a href="/capabilities" class={`nav-link ${currentPath === "/capabilities" ? "active" : ""}`}>Capabilities</a>
        </li>
        <li>
          <a href="/#gallery" class="nav-link">Showcase</a>
        </li>
        <li>
          <a href="/about" class={`nav-link ${currentPath === "/about" ? "active" : ""}`}>About Us</a>
        </li>
        <li>
          <a href="/contact" class={`nav-link ${currentPath === "/contact" ? "active" : ""}`}>Contact</a>
        </li>
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <!-- Theme Switcher Button -->
      <button type="button" class="theme-toggle-btn" onclick="window.toggleTheme()" aria-label="Toggle Dark/Light Mode" title="Toggle Theme">
        <svg class="theme-icon-dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
      </button>

      <!-- RFQ Button -->
      <a href="/#rfq-calculator" class="btn btn-primary btn-sm rfq-header-btn">
        <span>Request RFQ</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>

      <!-- Mobile Hamburger Toggle -->
      <button type="button" class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Open Navigation Menu">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-drawer" id="mobile-drawer">
    <div class="mobile-drawer-inner">
      <div class="mobile-drawer-header">
        <span class="mobile-title">MENU NAVIGATION</span>
        <button type="button" class="mobile-close-btn" id="mobile-close-btn" aria-label="Close menu">&times;</button>
      </div>
      <ul class="mobile-nav-list">
        <li><a href="/" class="mobile-nav-link">Home</a></li>
        <li>
          <div class="mobile-category">OUR SERVICES</div>
          <a href="/services/cnc-machining" class="mobile-sublink">● CNC Machining & Turning</a>
          <a href="/services/laser-cutting" class="mobile-sublink">● Fiber Laser Cutting (6kW)</a>
          <a href="/services/cad-engineering" class="mobile-sublink">● CAD / CAM & Engineering</a>
          <a href="/services/sheet-metal-fabrication" class="mobile-sublink">● Sheet Metal & Heavy Fabrication</a>
        </li>
        <li><a href="/capabilities" class="mobile-nav-link">Machinery & Capabilities</a></li>
        <li><a href="/#gallery" class="mobile-nav-link">Manufacturing Showcase</a></li>
        <li><a href="/about" class="mobile-nav-link">About Jecon Group</a></li>
        <li><a href="/contact" class="mobile-nav-link">Contact & Locations</a></li>
      </ul>
      <div class="mobile-drawer-footer">
        <a href="/#rfq-calculator" class="btn btn-primary w-full">Request Instant RFQ</a>
        <div class="mobile-quick-contacts">
          <div>Savli Plant: +91 85111 42772</div>
          <div>Corporate: info@jeconengineers.com</div>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    width: 100%;
    z-index: 100;
    background: rgba(10, 13, 18, 0.88);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid #2D333F;
    transition: all 0.3s ease;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
    gap: 1.5rem;
  }

  /* Logo */
  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
  }

  .logo-symbol svg {
    width: 38px;
    height: 38px;
    display: block;
    filter: drop-shadow(0 0 10px rgba(0, 240, 255, 0.4));
  }

  .logo-text {
    display: flex;
    flex-direction: column;
  }

  .company-name {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.35rem;
    letter-spacing: 0.04em;
    color: var(--text-primary);
    line-height: 1;
  }

  .company-sub {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--accent-cyan);
    margin-top: 0.15rem;
  }

  .company-tag {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-top: 0.1rem;
  }

  /* Navigation */
  .desktop-nav .nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 0.5rem;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.55rem 0.95rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--text-secondary);
    border-radius: var(--radius-md);
    transition: all 0.2s ease;
  }

  .nav-link:hover, .nav-link.active {
    color: var(--text-primary);
    background: rgba(14, 165, 233, 0.07);
  }

  .dropdown-chevron {
    transition: transform 0.25s ease;
  }

  .nav-dropdown-wrapper {
    position: relative;
  }

  .nav-dropdown-wrapper:hover .dropdown-chevron {
    transform: rotate(180deg);
  }

  /* Dropdown Menu */
  .dropdown-menu {
    position: absolute;
    top: calc(100% + 12px);
    left: 0;
    width: 320px;
    background: var(--bg-glass);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    box-shadow: var(--shadow-lg), 0 0 20px rgba(0, 240, 255, 0.1);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    backdrop-filter: blur(20px);
  }

  .nav-dropdown-wrapper:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.65rem 0.75rem;
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
  }

  .dropdown-item:hover {
    background: rgba(14, 165, 233, 0.06);
    transform: translateX(4px);
  }

  .drop-icon {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .drop-icon.cyan { background: rgba(0, 240, 255, 0.12); color: var(--accent-cyan); }
  .drop-icon.orange { background: rgba(255, 107, 0, 0.12); color: var(--accent-orange); }
  .drop-icon.blue { background: rgba(37, 99, 235, 0.15); color: #60a5fa; }
  .drop-icon.amber { background: rgba(245, 158, 11, 0.15); color: #fbbf24; }

  .drop-content strong {
    display: block;
    font-size: 0.9rem;
    color: var(--text-primary);
  }

  .drop-content span {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .theme-toggle-btn {
    background: rgba(14, 165, 233, 0.06);
    border: 1px solid #2D333F;
    color: var(--text-secondary);
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .theme-toggle-btn:hover {
    color: var(--accent-cyan);
    border-color: var(--accent-cyan);
    background: var(--accent-cyan-subtle);
  }

  .rfq-header-btn {
    padding: 0.6rem 1.15rem;
    font-size: 0.9rem;
  }

  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 38px;
    height: 38px;
    padding: 9px;
    background: rgba(14, 165, 233, 0.06);
    border: 1px solid #2D333F;
    border-radius: var(--radius-md);
    cursor: pointer;
  }

  .mobile-menu-btn .bar {
    height: 2px;
    width: 100%;
    background: var(--text-primary);
    border-radius: 2px;
    transition: 0.3s ease;
  }

  /* Mobile Drawer */
  .mobile-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(10px);
    z-index: 200;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }

  .mobile-drawer.open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-drawer-inner {
    position: absolute;
    top: 0;
    right: 0;
    width: 85%;
    max-width: 360px;
    height: 100%;
    background: #121417;
    border-left: 1px solid #2D333F;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    overflow-y: auto;
  }

  .mobile-drawer.open .mobile-drawer-inner {
    transform: translateX(0);
  }

  .mobile-drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .mobile-title {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-cyan);
    letter-spacing: 0.08em;
  }

  .mobile-close-btn {
    background: none;
    border: none;
    font-size: 1.8rem;
    color: var(--text-primary);
    cursor: pointer;
    line-height: 1;
  }

  .mobile-nav-list {
    list-style: none;
    margin: 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-nav-link {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
    display: block;
  }

  .mobile-category {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.75rem;
    margin-bottom: 0.5rem;
    letter-spacing: 0.05em;
  }

  .mobile-sublink {
    display: block;
    padding: 0.4rem 0.5rem;
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .mobile-drawer-footer {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.25rem;
  }

  .mobile-quick-contacts {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .w-full {
    width: 100%;
  }

  @media (max-width: 1024px) {
    .desktop-nav {
      display: none;
    }
    .mobile-menu-btn {
      display: flex;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const openBtn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('mobile-close-btn');
    const drawer = document.getElementById('mobile-drawer');

    if (openBtn && drawer) {
      openBtn.addEventListener('click', () => {
        drawer.classList.add('open');
      });
    }

    if (closeBtn && drawer) {
      closeBtn.addEventListener('click', () => {
        drawer.classList.remove('open');
      });
    }

    // Close on backdrop click
    if (drawer) {
      drawer.addEventListener('click', (e) => {
        if (e.target === drawer) {
          drawer.classList.remove('open');
        }
      });
    }
  });
</script>
