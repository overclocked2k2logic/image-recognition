---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import RfqEstimator from '../../components/RfqEstimator.astro';
import Footer from '../../components/Footer.astro';
---

<Layout 
  title="High-Precision CNC Machining & Turning | Jecon Engineering Services"
  description="Precision 3/4/5-Axis CNC Milling and Turning services in Vadodara, Gujarat. Tolerances down to ±0.005mm for aerospace, petrochemical, and power components."
>
  <Header currentPath="/services/cnc-machining" />

  <main class="service-detail-main">
    <!-- Breadcrumb & Hero -->
    <div class="service-hero-section">
      <div class="container">
        <div class="service-hero-content">
          <div class="tech-badge">
            <span class="dot"></span>
            <span>VMC & TURNING EXCELLENCE</span>
          </div>
          <h1>Multi-Axis <span class="gradient-text">CNC Machining & Turning</span></h1>
          <p>
            Delivering tight-tolerance, complex geometric metal components with 5-axis vertical machining centers, precision CNC lathes, and live-tooling turning centers at our Savli Vadodara plant.
          </p>
        </div>
      </div>
    </div>

    <!-- Main Detail Content -->
    <section class="section service-body-section">
      <div class="container">
        <div class="service-detail-grid">
          
          <!-- Left Main Body -->
          <div class="detail-body-col">
            <div class="media-feature-card">
              <img src="/assets/images/cnc-milling.jpeg" alt="5-Axis CNC Milling in operation" />
              <div class="media-feature-caption">5-Axis High-Speed VMC cutting alloy steel workpiece</div>
            </div>

            <h2>Micron-Level Engineering Capabilities</h2>
            <p>
              Jecon Engineering Services Pvt Ltd offers end-to-end CNC manufacturing services for prototypes, pilot production runs, and multi-thousand part production contracts. With advanced linear encoders and thermal stability controls, our machinery maintains tolerances down to <strong>±0.005 mm (5 microns)</strong>.
            </p>

            <div class="feature-bullets-grid">
              <div class="feat-box cyber-card">
                <h4>5-Axis Simultaneous Milling</h4>
                <p>Machining complex compound angles, impellers, turbine blades, and manifolds in a single setup for superior concentricity.</p>
              </div>
              <div class="feat-box cyber-card">
                <h4>Heavy & Precision Turning</h4>
                <p>Turning shafts, flanges, valve stems, and precision bushings up to Ø 450 mm and lengths up to 1,000 mm.</p>
              </div>
              <div class="feat-box cyber-card">
                <h4>Surface Roughness Control</h4>
                <p>Mirror surface finishes down to Ra 0.4 µm, eliminating the need for secondary cylindrical or surface grinding.</p>
              </div>
              <div class="feat-box cyber-card">
                <h4>High-Hardness Materials</h4>
                <p>Machining pre-hardened tool steels (up to 60 HRC), Inconel 718, Titanium Gr5, and austenitic stainless steels.</p>
              </div>
            </div>

            <!-- CNC Machine Specs Table -->
            <h3>Machining Center Technical Fleet</h3>
            <div class="table-responsive">
              <table class="tech-spec-table">
                <thead>
                  <tr>
                    <th>Machine Type</th>
                    <th>Work Envelope (X/Y/Z)</th>
                    <th>Spindle Specs</th>
                    <th>Tolerance Rating</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><strong>5-Axis VMC Center</strong></td>
                    <td>1,200 x 700 x 600 mm</td>
                    <td>15,000 RPM / BT40 / High Pressure Coolant</td>
                    <td><span class="highlight-cyan">± 0.005 mm</span></td>
                  </tr>
                  <tr>
                    <td><strong>4-Axis High-Rigidity VMC</strong></td>
                    <td>1,000 x 600 x 550 mm</td>
                    <td>12,000 RPM / 24 ATC</td>
                    <td><span class="highlight-cyan">± 0.008 mm</span></td>
                  </tr>
                  <tr>
                    <td><strong>CNC Slant Bed Lathe</strong></td>
                    <td>Ø 450 mm x 1,000 mm Length</td>
                    <td>4,500 RPM / 12-Station Turret</td>
                    <td><span class="highlight-cyan">± 0.005 mm</span></td>
                  </tr>
                  <tr>
                    <td><strong>Precision Mill-Turn Center</strong></td>
                    <td>Ø 320 mm x 650 mm Length</td>
                    <td>Live C-Axis Tooling / Sub-Spindle</td>
                    <td><span class="highlight-cyan">± 0.005 mm</span></td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- Parts Gallery Preview -->
            <h3>Featured CNC Components</h3>
            <div class="parts-dual-grid">
              <div class="part-item">
                <img src="/assets/images/cnc-parts.jpeg" alt="Finished CNC parts" />
                <div class="part-item-info">
                  <strong>Flanged Couplings & Bushings</strong>
                  <span>Material: SS 316L | Finish: Ra 0.4 µm</span>
                </div>
              </div>
              <div class="part-item">
                <img src="/assets/images/robotic-machining.jpeg" alt="Robotic brass sculpting" />
                <div class="part-item-info">
                  <strong>Custom Brass Valve Hardware</strong>
                  <span>Material: Brass C360 | High-Precision Turning</span>
                </div>
              </div>
            </div>

          </div>

          <!-- Right Sidebar -->
          <aside class="detail-sidebar-col">
            <div class="sidebar-card cyber-card">
              <h4>Direct CNC Inquiries</h4>
              <p>Speak directly with our Chief Estimator & Plant Head.</p>
              <div class="side-contact-list">
                <div class="side-item">
                  <span>General Manager:</span>
                  <strong>Mr. Devendra Singh</strong>
                </div>
                <div class="side-item">
                  <span>Direct Phone:</span>
                  <a href="tel:+918511142772">+91 85111 42772</a>
                </div>
                <div class="side-item">
                  <span>Email Drawings:</span>
                  <a href="mailto:info@jeconengineers.com">info@jeconengineers.com</a>
                </div>
              </div>
              <a href="#rfq-calculator" class="btn btn-primary w-full">Request Machining Quote</a>
            </div>

            <div class="sidebar-card cyber-card">
              <h4>Parent Group Legacy</h4>
              <p>Sister company to <strong>Jecon Engineers Pvt Ltd</strong>, providing 25+ years of heavy mechanical maintenance and shutdown support for India's largest refineries and petrochemical plants.</p>
              <a href="/about" class="btn btn-outline w-full">Learn About Jecon</a>
            </div>
          </aside>

        </div>
      </div>
    </section>

    <!-- Embedded RFQ -->
    <RfqEstimator />
  </main>

  <Footer />
</Layout>

<style>
  .service-hero-section {
    background: linear-gradient(180deg, var(--bg-secondary) 0%, var(--bg-primary) 100%);
    padding: 5rem 0 3rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .service-hero-content {
    max-width: 800px;
  }

  .service-hero-content h1 {
    margin: 1rem 0 1rem 0;
  }

  .service-detail-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 3rem;
  }

  .detail-body-col {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .media-feature-card {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-lg);
  }

  .media-feature-card img {
    width: 100%;
    height: 420px;
    object-fit: cover;
  }

  .media-feature-caption {
    background: var(--bg-card);
    padding: 0.85rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-secondary);
    border-top: 1px solid var(--border-subtle);
  }

  .feat-box {
    padding: 1.5rem;
  }

  .feature-bullets-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .table-responsive {
    overflow-x: auto;
  }

  .tech-spec-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .tech-spec-table th, .tech-spec-table td {
    padding: 1rem 1.25rem;
    text-align: left;
    border-bottom: 1px solid var(--border-subtle);
  }

  .tech-spec-table th {
    background: var(--bg-tertiary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-cyan);
    text-transform: uppercase;
  }

  .highlight-cyan {
    color: var(--accent-cyan);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .parts-dual-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .part-item {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: var(--bg-card);
    box-shadow: var(--shadow-sm);
    transition: transform 0.3s ease;
  }

  .part-item:hover {
    transform: translateY(-4px);
    border-color: var(--border-active);
  }

  .part-item img {
    width: 100%;
    height: 180px;
    object-fit: cover;
  }

  .part-item-info {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .part-item-info strong {
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .part-item-info span {
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  /* Sidebar */
  .detail-sidebar-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sidebar-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .side-contact-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.85rem;
    background: var(--bg-tertiary);
    padding: 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }

  .side-item {
    display: flex;
    flex-direction: column;
  }

  .side-item span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .side-item strong, .side-item a {
    color: var(--text-primary);
  }

  .w-full {
    width: 100%;
  }

  @media (max-width: 1024px) {
    .service-detail-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .feature-bullets-grid, .parts-dual-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
