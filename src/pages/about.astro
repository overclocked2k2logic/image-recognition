---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import SynergyHeritage from '../components/SynergyHeritage.astro';
import ContactHub from '../components/ContactHub.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="About Us | Jecon Engineering Services Pvt Ltd"
  description="Learn about Jecon Engineering Services Pvt Ltd and parent company Jecon Engineers Pvt Ltd. Over 25 years of engineering leadership in Vadodara, Gujarat."
>
  <Header currentPath="/about" />

  <main>
    <div class="about-hero-section">
      <div class="container">
        <div class="about-hero-content">
          <div class="tech-badge amber">
            <span class="dot"></span>
            <span>ABOUT JECON GROUP</span>
          </div>
          <h1>Decades of <span class="gradient-text">Mechanical Mastery</span> & Precision Innovation</h1>
          <p>
            Bridging 25+ years of heavy mechanical project execution with cutting-edge multi-axis CNC manufacturing, 6kW fiber laser cutting, and precision sheet metal fabrication.
          </p>
        </div>
      </div>
    </div>

    <!-- About Detailed Story -->
    <section class="section about-story-section">
      <div class="container">
        <div class="about-story-grid">
          
          <div class="about-story-text">
            <h2>Our Heritage & Evolution</h2>
            <p>
              Originally founded in Vadodara as Jalpa Enterprises, <strong>Jecon Engineers Pvt. Ltd.</strong> established itself as an indispensable mechanical engineering and construction partner for heavy process plants across India. Managing critical shutdown projects, rotary equipment overhauls, and equipment erection for petrochemical complexes, fertilizers, and power stations, Jecon earned a sterling reputation for technical integrity.
            </p>
            <p>
              To satisfy skyrocketing industry demand for micron-tolerance machined parts and rapid turnaround laser profile cutting, the group established <strong>Jecon Engineering Services Pvt. Ltd.</strong> — an advanced high-tech manufacturing plant situated in the prime industrial corridor of <strong>GIDC Savli, Manjusar (Vadodara)</strong>.
            </p>

            <div class="about-core-values">
              <div class="value-item cyber-card">
                <h4>Micron-Level Precision</h4>
                <p>Equipped with 5-axis VMC, CMM inspection, and calibrated toolholders to guarantee ±0.005mm tolerances on every part.</p>
              </div>
              <div class="value-item cyber-card">
                <h4>Speed & Reliability</h4>
                <p>6kW fiber laser with dual exchange pallets and extensive raw metal inventory ensures prompt turnaround times.</p>
              </div>
              <div class="value-item cyber-card">
                <h4>Engineering Depth</h4>
                <p>Managed by seasoned mechanical engineers with comprehensive static and rotary machinery background.</p>
              </div>
              <div class="value-item cyber-card">
                <h4>End-to-End Synergy</h4>
                <p>From initial 3D CAD modeling to fabrication, surface treatment, and on-site plant erection.</p>
              </div>
            </div>
          </div>

          <div class="about-story-visual">
            <div class="story-img-card">
              <img src="/assets/images/cad-workstation.jpeg" alt="Jecon CAD Engineering Workstation" />
            </div>
            <div class="story-img-card secondary">
              <img src="/assets/images/welding-fabrication.jpeg" alt="Jecon Certified Welder" />
            </div>
          </div>

        </div>
      </div>
    </section>

    <SynergyHeritage />
    <ContactHub />
  </main>

  <Footer />
</Layout>

<style>
  .about-hero-section {
    background: linear-gradient(180deg, var(--bg-secondary) 0%, var(--bg-primary) 100%);
    padding: 5rem 0 3rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .about-hero-content {
    max-width: 820px;
  }

  .about-hero-content h1 {
    margin: 1rem 0 1rem 0;
  }

  .about-story-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3.5rem;
    align-items: center;
  }

  .about-story-text h2 {
    margin-bottom: 1.25rem;
  }

  .about-story-text p {
    margin-bottom: 1.25rem;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .about-core-values {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .value-item {
    padding: 1.25rem;
  }

  .value-item h4 {
    font-size: 1rem;
    color: var(--accent-cyan);
    margin-bottom: 0.35rem;
  }

  .value-item p {
    font-size: 0.82rem;
    margin: 0;
    line-height: 1.45;
  }

  .about-story-visual {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .story-img-card {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-lg);
  }

  .story-img-card img {
    width: 100%;
    height: 260px;
    object-fit: cover;
  }

  @media (max-width: 1024px) {
    .about-story-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .about-core-values {
      grid-template-columns: 1fr;
    }
  }
</style>
