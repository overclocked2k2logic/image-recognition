---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Jecon Engineering Services Pvt Ltd | Precision CNC, Laser Cutting & Fabrication",
  description = "Jecon Engineering Services Pvt Ltd - Sister company of Jecon Engineers Pvt Ltd. Premium CNC machining, 6kW fiber laser cutting, CAD/CAM design, and heavy sheet metal fabrication in Vadodara, Gujarat."
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="Jecon Engineering Services, Jecon Engineers, CNC Machining Vadodara, Laser Cutting Savli Manjusar, Sheet Metal Fabrication Gujarat, CAD Engineering, 5-Axis VMC, Precision Machining India" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://jeconengineering.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/images/cnc-parts.jpeg" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/assets/images/cnc-parts.jpeg" />

    <!-- Preload Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  </head>
  <body>
    <!-- Top Announcement Bar -->
    <div class="top-announcement-bar">
      <div class="container top-bar-inner">
        <div class="top-bar-left">
          <span class="pulse-indicator"></span>
          <span><strong>Facility Status:</strong> Plant Operational & Accepting Orders</span>
          <span class="divider">|</span>
          <span class="heritage-text">A Sister Company of <strong>Jecon Engineers Pvt. Ltd.</strong> (Est. Vadodara)</span>
        </div>
        <div class="top-bar-right">
          <a href="tel:+918511142772" class="top-contact-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>+91 85111 42772</span>
          </a>
          <a href="mailto:info@jeconengineers.com" class="top-contact-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <span>info@jeconengineers.com</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Main Content Slot -->
    <slot />

    <!-- Floating Quick RFQ Action -->
    <aside class="floating-rfq" aria-label="Quick Quote Launcher">
      <a href="#rfq-calculator" class="floating-rfq-btn" id="floating-rfq-link">
        <span class="rfq-glow"></span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        <span>Instant RFQ</span>
      </a>
      <a href="https://wa.me/918511142772?text=Hello%20Jecon%20Engineering,%20I%20would%20like%20to%20request%20a%20quote%20for%20engineering%20services" target="_blank" rel="noopener noreferrer" class="floating-wa-btn" title="Chat on WhatsApp">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
      </a>
      <button type="button" id="back-to-top" class="back-to-top-btn" aria-label="Back to top" title="Back to top">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18 15 12 9 6 15"/></svg>
      </button>
    </aside>

    <script is:inline>
      // 1. Theme Initializer & Toggle
      function initTheme() {
        const storedTheme = localStorage.getItem('jecon-theme') || 'dark';
        document.documentElement.setAttribute('data-theme', storedTheme);
      }
      initTheme();

      window.toggleTheme = function() {
        const current = document.documentElement.getAttribute('data-theme') || 'light';
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('jecon-theme', next);
      };

      // 2. Global Scroll Animations (IntersectionObserver)
      document.addEventListener('DOMContentLoaded', () => {
        // Auto-assign reveal classes if not explicitly present
        const revealTargets = document.querySelectorAll(
          '.section-header, .cyber-card, .machine-card, .telemetry-card, .service-panel, .gallery-card, .mat-card, .cert-card, .spec-matrix, .step-item, .contact-card, .rfq-calculator-card'
        );

        revealTargets.forEach((el, index) => {
          if (!el.classList.contains('reveal-on-scroll') && !el.classList.contains('reveal-left') && !el.classList.contains('reveal-right')) {
            el.classList.add('reveal-on-scroll');
          }
        });

        const observerOptions = {
          root: null,
          rootMargin: '0px 0px -60px 0px',
          threshold: 0.12
        };

        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              
              // If element has counter numbers, trigger count animation
              const counters = entry.target.querySelectorAll('[data-counter]');
              counters.forEach(counter => {
                if (!counter.dataset.animated) {
                  animateCounter(counter);
                  counter.dataset.animated = 'true';
                }
              });
              
              obs.unobserve(entry.target);
            }
          });
        }, observerOptions);

        document.querySelectorAll('.reveal-on-scroll, .reveal-left, .reveal-right, .reveal-scale').forEach(el => {
          observer.observe(el);
        });

        // 3. Counter Animation Function
        function animateCounter(el) {
          const target = parseFloat(el.getAttribute('data-counter')) || 0;
          const prefix = el.getAttribute('data-prefix') || '';
          const suffix = el.getAttribute('data-suffix') || '';
          const decimals = parseInt(el.getAttribute('data-decimals')) || 0;
          const duration = 1800; // ms
          const startTime = performance.now();

          function update(now) {
            const progress = Math.min((now - startTime) / duration, 1);
            // Ease out cubic
            const easeOut = 1 - Math.pow(1 - progress, 3);
            const current = (easeOut * target).toFixed(decimals);
            el.innerText = prefix + current + suffix;

            if (progress < 1) {
              requestAnimationFrame(update);
            } else {
              el.innerText = prefix + target.toFixed(decimals) + suffix;
            }
          }
          requestAnimationFrame(update);
        }

        // 4. Back to Top Button Logic
        const backToTopBtn = document.getElementById('back-to-top');
        if (backToTopBtn) {
          window.addEventListener('scroll', () => {
            if (window.scrollY > 400) {
              backToTopBtn.classList.add('visible');
            } else {
              backToTopBtn.classList.remove('visible');
            }
          }, { passive: true });

          backToTopBtn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }

        // 5. Interactive 3D Card Hover Effect
        const cards = document.querySelectorAll('.cyber-card, .telemetry-card, .machine-card');
        cards.forEach(card => {
          card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            const rotateX = ((y - centerY) / centerY) * -4;
            const rotateY = ((x - centerX) / centerX) * 4;
            card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-6px)`;
          });

          card.addEventListener('mouseleave', () => {
            card.style.transform = '';
          });
        });
      });
    </script>
  </body>
</html>

<style>
  .top-announcement-bar {
    background: #0d1118;
    border-bottom: 1px solid #2D333F;
    font-size: 0.82rem;
    padding: 0.5rem 0;
    color: var(--text-secondary);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  [data-theme="light"] .top-announcement-bar {
    background: #f1f5f9;
    border-bottom: 1px solid rgba(203, 213, 225, 0.8);
  }

  .top-bar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .top-bar-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .pulse-indicator {
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 10px #10b981;
    animation: pulse 1.8s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  .divider {
    color: var(--border-subtle);
  }

  .heritage-text strong {
    color: var(--accent-cyan);
  }

  .top-bar-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .top-contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-secondary);
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .top-contact-link:hover {
    color: var(--accent-cyan);
  }

  /* Floating RFQ & WhatsApp */
  .floating-rfq {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    z-index: 99;
  }

  .floating-rfq-btn {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.45rem;
    background: linear-gradient(135deg, #0EA5E9 0%, #0284c7 100%);
    color: #ffffff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: var(--radius-full);
    box-shadow: 0 8px 25px rgba(14, 165, 233, 0.35);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(14, 165, 233, 0.3);
  }

  .floating-rfq-btn:hover {
    transform: translateY(-4px) scale(1.03);
    box-shadow: 0 12px 32px rgba(14, 165, 233, 0.55);
  }

  .floating-wa-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #25d366;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.35);
    align-self: flex-end;
    transition: all 0.3s ease;
  }

  .floating-wa-btn:hover {
    transform: scale(1.1) translateY(-2px);
    box-shadow: 0 10px 28px rgba(37, 211, 102, 0.55);
  }

  .back-to-top-btn {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #1E222B;
    border: 1px solid #2D333F;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: var(--shadow-md);
    align-self: flex-end;
    opacity: 0;
    transform: translateY(15px);
    pointer-events: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .back-to-top-btn.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .back-to-top-btn:hover {
    background: var(--accent-cyan);
    color: #ffffff;
    border-color: var(--accent-cyan);
    transform: translateY(-3px);
  }

  @media (max-width: 768px) {
    .top-announcement-bar {
      display: none;
    }
    .floating-rfq {
      bottom: 1.25rem;
      right: 1.25rem;
    }
  }
</style>
